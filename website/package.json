{
  "name": "@gardn/website",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "waku dev",
    "api:generate": "node scripts/generate-api-reference.mjs",
    "api:check": "node scripts/generate-api-reference.mjs --check",
    "api:generate:latest": "node scripts/generate-api-reference.mjs --publish-latest",
    "build": "pnpm api:generate && waku build",
    "check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node --test scripts/*.test.mjs",
    "content:check": "node scripts/check-built-site.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "fumadocs-core": "^16.14.0",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.14.0",
    "fumapress": "0.7.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "waku": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "4.118.0"
  }
}
