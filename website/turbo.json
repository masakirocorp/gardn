{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["SITE_URL"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["build", "content:check", "deploy:check", "format:check", "lint"]
    },
    "content:check": {
      "dependsOn": ["build"]
    },
    "deploy:check": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
