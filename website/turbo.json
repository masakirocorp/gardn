{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["gardn-rust#api:contract"],
      "env": ["GARDN_API_BINARY"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": [
        "api:check",
        "build",
        "content:check",
        "deploy:check",
        "format:check",
        "lint",
        "test"
      ]
    },
    "api:check": {
      "env": ["GARDN_API_BINARY"],
      "dependsOn": ["build"],
      "outputs": []
    },
    "content:check": {
      "dependsOn": ["build"]
    },
    "deploy:check": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "quality": {
      "inputs": ["$TURBO_ROOT$/turbo.json"],
      "dependsOn": ["check"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:all": {
      "inputs": ["$TURBO_ROOT$/turbo.json"],
      "dependsOn": ["test"]
    }
  }
}
