{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalCargoWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "globalEnv": [
    "AR",
    "ARFLAGS",
    "CARGO_*",
    "CC",
    "CFLAGS",
    "CI",
    "CXX",
    "CXXFLAGS",
    "DEVELOPER_DIR",
    "GITHUB_ACTIONS",
    "HOST_*",
    "LIBGHOSTTY_VT_*",
    "MACOSX_DEPLOYMENT_TARGET",
    "RANLIB",
    "RUST*",
    "SDKROOT",
    "TARGET_*",
    "ZIG"
  ],
  "globalPassThroughEnv": [
    "APPDATA",
    "CARGO_HOME",
    "HOME",
    "LOCALAPPDATA",
    "RUSTUP_HOME",
    "TEMP",
    "TMP",
    "TMPDIR",
    "USERPROFILE",
    "XDG_CACHE_HOME",
    "XDG_CONFIG_HOME",
    "XDG_DATA_HOME",
    "ZIG_GLOBAL_CACHE_DIR",
    "ZIG_LOCAL_CACHE_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "omh#build": {
      "env": ["LIBGHOSTTY_VT_OPTIMIZE", "LIBGHOSTTY_VT_SIMD"],
      "cache": false
    },
    "omh#check": {
      "command": ["cargo", "check", "--package=omh", "--all-targets", "--locked"],
      "outputs": []
    },
    "omh#format": {
      "command": ["cargo", "fmt", "--package", "omh"],
      "cache": false
    },
    "omh#format:check": {
      "command": ["cargo", "fmt", "--package", "omh", "--", "--check"],
      "outputs": []
    },
    "omh#lint": {
      "command": ["cargo", "clippy", "--package=omh", "--all-targets", "--locked", "--no-deps", "--", "-D", "warnings"],
      "outputs": []
    },
    "omh#test": {
      "command": [
        "cargo",
        "nextest",
        "run",
        "--locked",
        "--status-level",
        "fail",
        "--final-status-level",
        "fail",
        "--failure-output",
        "final",
        "--success-output",
        "never"
      ],
      "outputs": []
    },
    "omh#ci:test": {
      "command": [
        "cargo",
        "nextest",
        "run",
        "-P",
        "ci",
        "--locked",
        "--status-level",
        "slow",
        "--final-status-level",
        "slow",
        "--failure-output",
        "final",
        "--success-output",
        "never"
      ],
      "dependsOn": ["format:check", "lint"],
      "env": ["CARGO_INCREMENTAL"],
      "outputs": []
    },
    "omh-rust#ast:check": {
      "command": [
        "node",
        "scripts/run-ast-grep.mjs",
        "scan",
        "--config",
        "sgconfig.yml",
        "apps/omh/src",
        "--report-style",
        "short",
        "--error"
      ],
      "outputs": []
    },
    "omh-rust#api:contract": {
      "inputs": [
        "apps/omh/src/api/**",
        "apps/omh/src/app/api.rs",
        "apps/omh/src/app/api/**",
        "website/.generated/api/schema.json",
        "website/scripts/generate-api-reference.mjs"
      ],
      "outputs": []
    },
    "omh-rust#maintenance:test": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "scripts.test_agent_detection_manifest_check",
        "scripts.test_vendor_libghostty_vt",
        "scripts.test_vendor_portable_pty",
        "scripts.test_testing_guidelines",
        "scripts.test_extract_release_notes",
        "scripts.test_check_tegami_release_scope",
        "scripts.test_codex_status_fallback",
        "scripts.test_opencode_status_fallback",
        "scripts.test_pi_omp_status_validation",
        "scripts.test_qoder_proxy_status_validation",
        "scripts.test_agent_status_acceptance_invariant",
        "scripts.test_agent_model_candidates",
        "scripts.test_remaining_status_fallback",
        "scripts.test_agent_workflows"
      ],
      "outputs": []
    },
    "omh-rust#test:all": {
      "dependsOn": ["omh#test", "omh-rust#maintenance:test"]
    },
    "omh-rust#docs:reminder": {
      "command": [
        "python3",
        "-c",
        "print('docs reminder: if this changes user-facing behavior, update docs/features.md or call it out before release.')"
      ],
      "outputs": []
    },
    "omh-rust#quality": {
      "dependsOn": [
        "omh#ci:test",
        "omh-rust#docs:reminder",
        "omh-rust#ast:check",
        "omh-rust#maintenance:test"
      ]
    }
  }
}
