{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "^check"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": []
    },
    "@omh/app#build": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@omh/app#check": {
      "cache": false,
      "dependsOn": [
        "^check"
      ],
      "outputs": []
    },
    "@omh/app#lint": {
      "cache": false,
      "outputs": []
    },
    "@omh/app#test": {
      "cache": false,
      "dependsOn": [
        "^test"
      ],
      "outputs": []
    }
  }
}
