{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "experimentalCargoWorkspaces": true,
    "experimentalTaskCommand": true
  },
  "globalEnv": [
    "AR",
    "ARFLAGS",
    "CARGO_*",
    "CC",
    "CFLAGS",
    "CI",
    "CXX",
    "CXXFLAGS",
    "DEVELOPER_DIR",
    "GITHUB_ACTIONS",
    "HOST_*",
    "LIBGHOSTTY_VT_*",
    "MACOSX_DEPLOYMENT_TARGET",
    "RANLIB",
    "RUST*",
    "SDKROOT",
    "TARGET_*",
    "ZIG"
  ],
  "globalPassThroughEnv": [
    "APPDATA",
    "CARGO_HOME",
    "HOME",
    "LOCALAPPDATA",
    "RUSTUP_HOME",
    "TEMP",
    "TMP",
    "TMPDIR",
    "USERPROFILE",
    "XDG_CACHE_HOME",
    "XDG_CONFIG_HOME",
    "XDG_DATA_HOME",
    "ZIG_GLOBAL_CACHE_DIR",
    "ZIG_LOCAL_CACHE_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "gardn#build": {
      "env": [
        "LIBGHOSTTY_VT_OPTIMIZE",
        "LIBGHOSTTY_VT_SIMD",
        "GARDN_BUILD_CHANNEL",
        "GARDN_BUILD_COHORT",
        "GARDN_RELEASE_TAG"
      ],
      "cache": false
    },
    "gardn#check": {
      "command": ["cargo", "check", "--package=gardn", "--all-targets", "--locked"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/Cargo.toml"
      ],
      "outputs": []
    },
    "gardn#format": {
      "command": ["cargo", "fmt", "--package", "gardn"],
      "cache": false
    },
    "gardn#format:check": {
      "command": ["cargo", "fmt", "--package", "gardn", "--", "--check"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/Cargo.toml"],
      "outputs": []
    },
    "gardn#lint": {
      "command": ["cargo", "clippy", "--package=gardn", "--all-targets", "--locked", "--no-deps", "--", "-D", "warnings"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/Cargo.toml"
      ],
      "outputs": []
    },
    "gardn#test": {
      "command": ["cargo", "nextest", "run", "--locked"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/.config/nextest.toml"
      ],
      "outputs": []
    },
    "gardn#ci:test": {
      "command": ["cargo", "nextest", "run", "-P", "ci", "--locked"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/.config/nextest.toml"
      ],
      "dependsOn": ["format:check", "lint"],
      "env": ["CARGO_INCREMENTAL"],
      "outputs": []
    },
    "gardn-rust#ast:check": {
      "command": [
        "node",
        "scripts/run-ast-grep.mjs",
        "scan",
        "--config",
        "sgconfig.yml",
        "apps/gardn/src",
        "--report-style",
        "short",
        "--error"
      ],
      "inputs": [
        "apps/gardn/src/**",
        "ast-grep/rules/**",
        "package.json",
        "pnpm-lock.yaml",
        "scripts/run-ast-grep.mjs",
        "sgconfig.yml"
      ],
      "outputs": []
    },
    "gardn-rust#api:contract": {
      "inputs": [
        "apps/gardn/src/api/**",
        "apps/gardn/src/app/api.rs",
        "apps/gardn/src/app/api/**",
        "website/.generated/api/schema.json",
        "website/scripts/generate-api-reference.mjs"
      ],
      "outputs": []
    },
    "gardn-rust#maintenance:test": {
      "command": [
        "python3",
        "-m",
        "unittest",
        "scripts.test_agent_detection_manifest_check",
        "scripts.test_vendor_libghostty_vt",
        "scripts.test_vendor_portable_pty",
        "scripts.test_testing_guidelines",
        "scripts.test_extract_release_notes",
        "scripts.test_check_tegami_release_scope",
        "scripts.test_release_build_identity",
        "scripts.test_codex_status_fallback",
        "scripts.test_agent_cohort_resolve",
        "scripts.test_agent_image_doctor",
        "scripts.test_maki_status_fallback",
        "scripts.test_opencode_status_fallback",
        "scripts.test_pi_omp_status_validation",
        "scripts.test_qoder_proxy_status_validation",
        "scripts.test_agent_status_acceptance_invariant",
        "scripts.test_agent_model_candidates",
        "scripts.test_remaining_status_fallback",
        "scripts.test_agent_workflows"
      ],
      "inputs": [
        ".github/workflows/agent-tests.yml",
        ".github/workflows/live-agent-tests.yml",
        "Cargo.lock",
        "Cargo.toml",
        "apps/gardn/Cargo.toml",
        "apps/gardn/src/**",
        "apps/gardn/tests/**",
        "apps/gardn/vendor/**",
        "ci/agent-test/**",
        "ci/agent-tests/**",
        "nix/package.nix",
        "scripts/**",
        "website/agent-detection/**"
      ],
      "outputs": []
    },
    "gardn-rust#test:all": {
      "inputs": ["$TURBO_ROOT$/turbo.json"],
      "dependsOn": ["gardn#test", "gardn-rust#maintenance:test"]
    },
    "gardn-rust#release-scope:check": {
      "command": ["node", "scripts/check-tegami-release-scope.mts", "gardn"],
      "inputs": [
        ".tegami/**",
        "scripts/check-tegami-release-scope.mts",
        "scripts/tegami.mts"
      ],
      "outputs": []
    },
    "gardn-rust#lint:all": {
      "dependsOn": ["@gardn/website#lint", "gardn#lint", "gardn-rust#ast:check"],
      "inputs": ["$TURBO_ROOT$/turbo.json"]
    },
    "gardn-rust#quality": {
      "inputs": ["$TURBO_ROOT$/turbo.json"],
      "dependsOn": [
        "gardn#ci:test",
        "gardn-rust#ast:check",
        "gardn-rust#maintenance:test",
        "gardn-rust#release-scope:check"
      ]
    }
  }
}
